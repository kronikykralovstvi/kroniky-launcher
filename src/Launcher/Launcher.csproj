<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KronikyKralovstviLauncher</AssemblyName>
    <Version>1.1.2</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Mods/*.cs" Link="Mods/%(Filename)%(Extension)" />
    <EmbeddedResource Include="logo.png" LogicalName="KronikyKralovstviLauncher.logo.png" />
    <EmbeddedResource Include="Assets/launcher-design.png" LogicalName="KronikyKralovstviLauncher.launcher-design.png" />
  </ItemGroup>
</Project>
